            "expected_condition": "availability eq 1",
            "evaluation_operator": "eq",
            "threshold": 1,
            "observation_window_seconds": 300,
            "minimum_sample_count": 3,
            "timeout_seconds": 10,
            "authoritative_source": "prometheus-test",
            "onboarding_registry_reference": "validator-registry:payments-test-availability"
          },
          "query": "min(up{tenant_id=\"example-tenant\",service=\"payments-api\",environment=\"test\"})",
          "step_seconds": 15
