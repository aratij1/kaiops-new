            "authoritative_source": "prometheus-test",
            "onboarding_registry_reference": "validator-registry:payments-test-alert_clearance"
          },
          "query": "sum(ALERTS{tenant_id=\"example-tenant\",service=\"payments-api\",environment=\"test\",alertname=\"PaymentsDown\",alertstate=\"firing\"}) or vector(0)",
          "step_seconds": 15
        },
        {
          "spec": {
